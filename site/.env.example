# Supabase — get these from your Supabase Dashboard → Settings → API
#
# 1. NEXT_PUBLIC_SUPABASE_URL  — Project URL (https://xxxxx.supabase.co)
# 2. NEXT_PUBLIC_SUPABASE_ANON_KEY — anon/public key (safe for browser, RLS-protected)
# 3. SUPABASE_SERVICE_ROLE_KEY — service_role key (SERVER-ONLY, bypasses RLS, never import in client code)
#
# Copy this file to .env.local and fill in real values. .env.local is gitignored.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
