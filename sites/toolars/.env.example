# Toolars environment variables
#
# Copy this file to `.env` (local dev) or set these in your hosting provider's
# dashboard (production). Lines marked REQUIRED must be set before a production
# deploy; lines marked OPTIONAL fall back to a safe local default.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Public canonical site URL. Used for metadataBase, canonical links, sitemap,
# robots, OpenGraph, and JSON-LD absolute URLs. REQUIRED in production.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# ---------------------------------------------------------------------------
# Auth (Toolars signed session)
# ---------------------------------------------------------------------------
# Secret used to sign Toolars session cookies. Generate with:
#   openssl rand -base64 48
# REQUIRED in production (the server throws if missing in NODE_ENV=production).
TOOLARS_AUTH_SESSION_SECRET=

# Optional comma-separated list of previous secrets used during rotation.
# Active signed cookies verify against the current secret first, then these.
TOOLARS_AUTH_SESSION_SECRET_PREVIOUS=

# ---------------------------------------------------------------------------
# Auth (Google OAuth)
# ---------------------------------------------------------------------------
# Create credentials at https://console.cloud.google.com/apis/credentials
# (OAuth client → Web application). Set the authorized redirect URI to:
#   https://your-domain.example/api/auth/google/callback
# REQUIRED once you enable real sign-in. The site runs in Free Trial Mode
# (anonymous) without them, but Sign in / Sign up will return 503.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# ---------------------------------------------------------------------------
# Free Trial Mode
# ---------------------------------------------------------------------------
# When enabled (default), Pricing/Billing/upgrade copy is hidden and the site
# stays free-to-start. Set to "disabled" to surface paid plans and billing.
# OPTIONAL. Defaults to enabled.
NEXT_PUBLIC_TOOLARS_FREE_TRIAL_MODE=enabled

# ---------------------------------------------------------------------------
# Production runtime persistence
# ---------------------------------------------------------------------------
# Base directory for server-side JSON stores (account profiles, auth session
# ledger, AI consent/run ledger, PDF upload metadata, encrypted PDF objects).
# Set this to a persistent volume path in production so stores survive redeploys
# and are not written inside `.next/cache`. OPTIONAL (falls back to .next/cache).
# TOOLARS_DATA_DIR=/var/data/toolars

# Per-store overrides (all OPTIONAL). If unset, derived from TOOLARS_DATA_DIR.
# TOOLARS_ACCOUNT_STORE_PATH=
# TOOLARS_AUTH_SESSION_LEDGER_PATH=
# TOOLARS_AI_CONSENT_LEDGER_PATH=
# TOOLARS_PDF_UPLOAD_TEMP_STORE_PATH=
# TOOLARS_PDF_UPLOAD_OBJECT_ROOT=

# PDF upload object encryption and signed handoff secrets. Local dev can omit
# these and use local-only fallbacks; production PDF upload/workflow handoff
# should set both. Generate each with: openssl rand -base64 48
# TOOLARS_OBJECT_STORAGE_ENCRYPTION_KEY=
# TOOLARS_UPLOAD_HANDOFF_SECRET=

# ---------------------------------------------------------------------------
# AI provider (cloud AI steps: PDF summary, repurpose, etc.)
# ---------------------------------------------------------------------------
# HTTP base URL + bearer key for your AI provider gateway. When unset, AI
# routes return a clear "not configured" error and the site runs local-only.
# OPTIONAL for Free Trial; REQUIRED to monetize AI features.
TOOLARS_AI_PROVIDER_ENDPOINT=
TOOLARS_AI_PROVIDER_API_KEY=

# ---------------------------------------------------------------------------
# Billing provider (subscriptions, invoices, customer portal)
# ---------------------------------------------------------------------------
# HTTP base URL + bearer key for your billing provider (e.g. Lemon Squeezy
# customer API wrapper). When unset, /api/billing/account falls back to a
# local preview account. OPTIONAL for Free Trial; REQUIRED to charge.
TOOLARS_BILLING_PROVIDER_ENDPOINT=
TOOLARS_BILLING_PROVIDER_API_KEY=

# ---------------------------------------------------------------------------
# Error monitoring (Sentry)
# ---------------------------------------------------------------------------
# Set SENTRY_DSN to enable Sentry error tracking. No-op when unset.
# Get your DSN at https://sentry.io/settings/projects/
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# ---------------------------------------------------------------------------
# Product analytics (PostHog)
# ---------------------------------------------------------------------------
# Set NEXT_PUBLIC_POSTHOG_KEY to enable analytics. No-op when unset.
# Get your key at https://app.posthog.com/project/settings
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
