    "next": "16.2.6",
    "next-intl": "^4.13.0",
    "posthog-js": "^1.391.3",
    "posthog-node": "^5.38.2",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^29.1.1",
    "pixelmatch": "^7.2.0",
    "playwright": "1.55.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7"
  }
