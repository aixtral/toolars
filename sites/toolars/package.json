    "smoke:public-workspaces": "node scripts/public-tool-workspace-smoke.mjs",
    "audit:i18n": "node scripts/audit-i18n.mjs",
    "audit:i18n-quality": "node scripts/audit-i18n-quality.mjs --fail-on-needs-work",
    "audit:tool-inventory": "node scripts/audit-tool-inventory.mjs",
    "launch:route-crawl": "node scripts/launch-route-crawl.mjs",
    "launch:readiness": "node scripts/launch-readiness-report.mjs",
    "release:health": "node scripts/check-production-health.mjs",
    "visual:design-pack": "node scripts/visual-verify-design-pack.mjs",
